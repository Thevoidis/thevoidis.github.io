{{- /* ─────────────────────────────────────────────────────────────────────────
  Comic pages, derived from static/comics/<folder>/comic.json.

  For every folder under static/comics/ that contains a comic.json (the
  hand-edited metadata: title, author, description, direction, cover), this
  adapter adds a Hugo page at /comics/<slug>/ rendered by
  layouts/comics/comic.html, which embeds the viewer in an iframe. The page
  also emits Manifest output, so Hugo writes /comics/<dir>/manifest.json with
  its `pages` array rebuilt from the images in the folder — the Comic Viewer
  manifest the reader actually fetches. One folder, one small metadata file,
  and a complete manifest is produced: nothing else to wire up.

  Images can be .webp / .png / .jpg — the generated manifest lists every image
  found in the folder, so the reader always matches the directory contents.

  Publishing a comic = drop the folder in; nothing else to wire up.
───────────────────────────────────────────────────────────────────────────── */ -}}
{{- $root := "static/comics" -}}
{{- range readDir $root -}}
  {{- if .IsDir -}}
    {{- $dir := .Name -}}
    {{- $metaPath := printf "%s/%s/comic.json" $root $dir -}}
    {{- if fileExists $metaPath -}}
      {{- $m := dict -}}
      {{- with readFile $metaPath | transform.Unmarshal -}}{{- $m = . -}}{{- end -}}
      {{- with default $dir ($m.title) -}}
        {{- $.AddPage (dict
              "kind" "page"
              "path" $dir
              "layout" "comic"
              "outputs" (slice "HTML" "Manifest")
              "title" .
              "description" (default "" ($m.description))
              "params" (dict "comicDir" $dir)) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
